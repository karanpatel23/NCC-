# ---------------------------------------------------------------------------
# NCC Infraspace website rebuild
#
# DELIBERATELY NOT IGNORED: forensics/out/
# That directory is evidence, not build output. It is the only readable record
# of a site that cannot be extracted without a browser. Screenshots and JSON
# in forensics/out/ are committed on purpose. Do not add it here.
# See CLAUDE.md > "Directory contract".
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.js
jspm_packages/

# Playwright browser binaries + test noise (browsers live in ~/Library/Caches)
/forensics/test-results/
/forensics/playwright-report/
/forensics/blob-report/
/forensics/.playwright/
.cache/ms-playwright/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Build output (phase 4 onward, under site/)
/site/dist/
/site/build/
/site/out/
/site/.next/
/site/.nuxt/
/site/.svelte-kit/
/site/.astro/
/site/.vercel/
/site/.netlify/
/site/.turbo/

# Editor / IDE
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# macOS / OS cruft
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Scratch
*.tmp
tmp/
scratch/
